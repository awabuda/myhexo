// Custom styles.

.post-body pre.mermaid,
.posts-expand .post-body pre.mermaid
  background: transparent
  border: none
  margin: 1.5em auto
  padding: 0
  text-align: center
  overflow-x: auto

.post-body pre.mermaid code
  background: transparent
  padding: 0

.mermaid svg
  max-width: 100%
  height: auto

.book-nav
  margin-top: 40px
  padding-top: 20px

  a
    display: block
    line-height: 1.5

  .post-nav-direction
    display: block
    font-size: 12px
    color: $grey
    margin-bottom: 4px

  .post-nav-title
    display: block
    font-size: 15px

  .post-nav-prev a
    padding-left: 18px

  .post-nav-next a
    padding-right: 18px
    text-align: right

  .post-nav-prev .fa
    left: 0

  .post-nav-next .fa
    right: 0
    left: auto
